{
  "name": "nconsole",
  "version": "1.0.7",
  "description": "Next-generation front-end debugging console. Replaces vConsole with AI streaming log support, modern web & mobile H5 optimization.",
  "main": "dist/nextconsole.umd.js",
  "module": "dist/nextconsole.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nextconsole.es.js",
      "require": "./dist/nextconsole.umd.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build --config vite.config.mts && npm run build:cdn",
    "build:cdn": "vite build --config vite.cdn.config.mts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run test && npm run build"
  },
  "keywords": [
    "console",
    "debugger",
    "vconsole",
    "devtools",
    "mobile",
    "h5",
    "ai",
    "streaming",
    "sse"
  ],
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "^25.6.0",
    "typescript": "^5.4.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^3.2.7",
    "ws": "^8.20.0"
  }
}
