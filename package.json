{
  "name": "nconsole",
  "version": "2.0.0",
  "description": "Next-generation front-end debugging console. Replaces vConsole with AI streaming log support, modern web & mobile H5 optimization.",
  "main": "dist/nconsole.cjs",
  "module": "dist/nconsole.es.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nconsole.es.mjs",
      "require": "./dist/nconsole.cjs"
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "import": "./dist/lite.mjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs"
    },
    "./plugins/source": {
      "types": "./dist/plugins/source-plugin.d.ts",
      "import": "./dist/plugins/source.mjs"
    },
    "./plugins/performance": {
      "types": "./dist/plugins/performance-plugin.d.ts",
      "import": "./dist/plugins/performance.mjs"
    },
    "./plugins/mimo-ai-diagnosis": {
      "types": "./dist/plugins/mimo-ai-diagnosis-plugin.d.ts",
      "import": "./dist/plugins/mimo-ai-diagnosis.mjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/asset/**"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:artifacts && npm run build:cjs && npm run build:types && npm run check:bundle && npm run check:exports",
    "build:artifacts": "node ./scripts/build-artifacts.mjs",
    "build:main": "vite build --config vite.config.mts",
    "build:cjs": "node ./scripts/build-cjs-wrapper.mjs",
    "build:lite": "vite build --config vite.entry.config.mts --mode lite",
    "build:core": "vite build --config vite.entry.config.mts --mode core",
    "build:plugins": "npm run build:plugin:source && npm run build:plugin:performance && npm run build:plugin:mimo",
    "build:plugin:source": "vite build --config vite.entry.config.mts --mode plugin-source",
    "build:plugin:performance": "vite build --config vite.entry.config.mts --mode plugin-performance",
    "build:plugin:mimo": "vite build --config vite.entry.config.mts --mode plugin-mimo",
    "build:cdn": "vite build --config vite.cdn.config.mts",
    "build:cdn:lite": "vite build --config vite.lite-cdn.config.mts",
    "build:types": "tsc -p tsconfig.build.json",
    "check:bundle": "node ./scripts/check-bundle-budget.mjs",
    "check:exports": "node ./scripts/check-package-exports.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run test && npm run build"
  },
  "keywords": [
    "console",
    "debugger",
    "vconsole",
    "devtools",
    "mobile",
    "h5",
    "ai",
    "streaming",
    "sse"
  ],
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.4.0",
    "vite": "^8.2.1",
    "vitest": "^3.2.7",
    "ws": "^8.20.0"
  }
}
